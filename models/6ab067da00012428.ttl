<http://model.geneontology.org/6ab067da00012428> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00012428> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-7646-0052"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-30"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "FGF23-KL-FGFR signaling in kidney distal tubule (Mouse)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Built from UniProt FGF23 curation and PMID:24434184 (TRPV5) and PMID:24797667 (NCC), full texts. FGFR involvement shown with pan-FGFR inhibitor PD173074; FGFR1c as the distal tubule receptor is the authors' model, not genetically shown. SGK1 direct phosphorylation of WNK4 reported in PMID:17360471; here supported by SGK1-inhibitor-sensitive WNK4 phosphorylation. SPAK/OSR1 not modelled (only background in PMID:24797667)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_10090> .

