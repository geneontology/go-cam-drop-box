<http://model.geneontology.org/6ab067da00006859> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00006859> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0002-5283-6593" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-09"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Cone to OFF bipolar glutamatergic transmission (Mouse)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Curated with GO AI HUB. Light-adapted cone to OFF bipolar cell glutamatergic transmission in mouse: Cav1.4 -> Syt1-triggered release -> kainate/AMPA receptors."^^xsd:string ,
                                                               "Light-adapted (photopic) signal transmission from cone photoreceptors to OFF cone bipolar cells, phototransduction omitted. Light hyperpolarizes the cone; Cav1.4 (Cacna1f) is voltage-gated, so hyperpolarization reduces Ca2+ influx at the ribbon active zone, reducing Syt1-triggered glutamate exocytosis and thus kainate/AMPA receptor activation in OFF bipolar dendrites (sign-preserving: OFF bipolar cells hyperpolarize). Causal edges are drawn in the activity-flow (positive) direction; under light all activities decrease together. Receptor enablers are GO complexes because the mouse OFF-bipolar subunit composition (GluK1? GluA?) was not verified from accessible full text."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_10090> .

