###  http://model.geneontology.org/685de18700004836/685de18700004923
<http://model.geneontology.org/685de18700004836/685de18700004923> rdf:type owl:NamedIndividual ,
                                                                           <http://purl.obolibrary.org/obo/GO_0008120> ;
                                                                  <http://purl.obolibrary.org/obo/BFO_0000050> <http://model.geneontology.org/685de18700004836/685de18700004925> ;
                                                                  <http://purl.obolibrary.org/obo/BFO_0000066> <http://model.geneontology.org/685de18700004836/6ab067da00017810> ;
                                                                  <http://purl.obolibrary.org/obo/RO_0002233> <http://model.geneontology.org/685de18700004836/685de18700004920> ,
                                                                                                              <http://model.geneontology.org/685de18700004836/685de18700004931> ;
                                                                  <http://purl.obolibrary.org/obo/RO_0002234> <http://model.geneontology.org/685de18700004836/685de18700004935> ;
                                                                  <http://purl.obolibrary.org/obo/RO_0002333> <http://model.geneontology.org/685de18700004836/685de18700004924> ;
                                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0009-0002-7487-1936" ;
                                                                  <http://purl.org/dc/elements/1.1/date> "2026-11-19"^^xsd:string ;
                                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                                   "https://holthuis-lab-uos.de" ;
                                                                  rdfs:comment "Location (occurs in GO:0098548 cytoplasmic side of Golgi membrane): IDA Halter et al. 2007 (PMID:17923531), HA-tagged human GCS (NM_003358) stably expressed in HeLa, immuno-EM: present in all five Golgi cisternae, enriched in cisternae 3-5 (medial-trans), absent from ER and nuclear envelope (overexpressed tagged protein). Cytosolic side: IC from Futerman & Pagano 1991 (PMID:1747103), rat liver fractions, limited proteolysis of intact Golgi vesicles blocked GlcCer synthesis."^^xsd:string ,
                                                                               "RHEA:12088: an N-acylsphing-4-enine + UDP-alpha-D-glucose = a beta-D-glucosyl-(1<->1')-N-acylsphing-4-enine + UDP + H+. Mapped to GO:0008120 (rhea2go); annotated in UniProt to UGCG (Q16739), experimental, PMID:8643456."^^xsd:string .

