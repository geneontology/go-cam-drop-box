<http://model.geneontology.org/6ab067da00006813> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00006813> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0002-5283-6593" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-09"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Oxyntomodulin-GLP1R stimulated insulin secretion (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                   "https://www.uniprot.org" ;
                                                  rdfs:comment "Insulin: native OXM infusion increased glucose-dependent insulin secretion rate in obese humans with and without T2DM (PMID:29545266, abstract only) -> IDA on the OXM pathway; GLP1R pathway part of GSIS and GLP1R in beta-cell plasma membrane are IC. GLP1R-dependence of OXM-stimulated insulin secretion shown in mouse Glp1r-/- islets and INS-1 cells (PMID:18669601, abstract only), not used as evidence in this human model."^^xsd:string ,
                                                               "Not modelled: beta-arrestin 1/2 and GRK2 recruitment and arrestin contribution to pERK1/2 (PMID:17395766, 27315480, 38360293); OXM reduction of beta-cell apoptosis (PMID:18669601); OXM action on GCGR. Upstream OXM production by L cells: see gomodel:6ab067da00005905."^^xsd:string ,
                                                               "OXM enabler = GCG peptide chain UniProtKB:P01275-PRO_0000011255 (aa 53-89). OXM->GLP1R IDA from cAMP and BRET assays in GLP-1R-expressing cells (PMID:27315480 full text; PMID:17395766). GLP1R part of AC-activating GPCR pathway: OXM cAMP blocked by adenylyl cyclase inhibitors (PMID:27315480, Fig S1)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

